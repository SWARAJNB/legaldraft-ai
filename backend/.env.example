# Storage Service Configuration

# Storage Mode: 's3' or 'local' (default: local)
STORAGE_MODE=local

# Local storage path (used when STORAGE_MODE=local)
LOCAL_STORAGE_DIR=./data

# Database Metadata URL
DATABASE_URL=sqlite:///./metadata.db

# AWS S3 Configuration (used when STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name
# Optional: custom endpoint URL for local emulation (e.g. LocalStack or MinIO)
AWS_S3_ENDPOINT_URL=
